{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "m3u8_parser",
  "version": "0.1.0",
  "identifier": "top.t-n.m3u8Parser",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9090",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "m3u8 parser",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.ico",
      "icons/128x128.ico",
      "icons/128x128@2x.ico"
    ]
  }
}
